@page "/new-race"
@inject IJSRuntime JS
@if (currentRace != null)
{
    <div class="page">
        <div class="box-body">
            <div class="top-row">
                <h1 class="top-row-title">@currentRace.Name</h1>

            </div>
            <div>
                <label>Name</label>
                <input type="text" @onchange="UpdateName" class="form-control race-input" value="@currentRace.Name" placeholder="Name" />
            </div>
        </div>
        <div class="box-body">
            <div class="top-row">
                <h1 class="top-row-title">Startlists</h1>
                <div class="top-row-buttons">
                    <button class="btn btn-normal" @onclick="@(AddStartlist)">
                        <span>Add</span>
                        <i class="bi btn-bi bi-plus-lg"></i>
                    </button>
                </div>
            </div>
            <div>

            </div>
        </div>

        @foreach (var startlist in currentRace.Startlists)
        {
            <div class="box-body">
                <div class="top-row">
                    <h2 class="top-row-title">
                        @startlist.Name

                    </h2>
                </div>

                <div class="d-flex flex-column gap-3">
                    <div>
                        <label>Name:</label>
                        <input type="text" class="form-control" value="@startlist.Name" placeholder="Untitled Startlist"
                               @onchange="@(async(ChangeEventArgs e)=>
                               {
                                   startlist.Name = e.Value?.ToString() ?? "Untitled Startlist";
                                   await SaveRace();
                               })" />
                      </div>
                      <div>
                          <label>Race Type:</label>
                          <select class="form-control"
                                  @onchange="@(async (ChangeEventArgs e) => { startlist.InputRaceType(e); await SaveRace(); })">
                            @foreach (var raceType in RaceType.RaceTypes)
                            {
                                @if (startlist.RaceType.Id == raceType.Id)
                                {

                                    <option selected value="@raceType.Id">@raceType.Name</option>
                                }
                                else
                                {
                                    <option value="@raceType.Id">@raceType.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label>Start Type:</label>
                        <select class="form-control"
                                @onchange="@(async(ChangeEventArgs args)=>
                                {
                                    startlist.InputStarttype(args);
                                    await SaveRace();
                                })">
                            @foreach (var startType in StartType.StartTypes)
                            {
                                @if (startlist.StartType.Id == startType.Id)
                                {
                                    <option selected value="@startType.Id">@startType.Name</option>
                                }
                                else
                                {
                                    <option value="@startType.Id">@startType.Name</option>
                                }
                            }
                        </select>
                    </div>
                    @if (startlist.RaceType.Id == RaceType.MultipleLaps.Id)
                    {
                        <div>
                            <label>Lap Count:</label>
                            <div class="input-group">
                                <input type="number" inputmode="numeric" step="1" class="form-control" aria-label="Lap Count" value="@startlist.LapCount.ToString(CultureInfo.InvariantCulture)" @onchange="@(async (ChangeEventArgs args) => { await startlist.InputLapCount(args, toasts); await SaveRace(); })">
                                <span class="form-control">Laps</span>
                            </div>
                        </div>
                    }
                    <div>
                        @if (startlist.RaceType.Id == RaceType.SingleCourse.Id)
                        {
                            <label>Distance:</label>
                        }
                        else
                        {
                            <label>Lap Distance:</label>
                        }
                        <div class="input-group mb-3">
                            <input type="number" inputmode="decimal" step="any" class="form-control" aria-label="Distance"
                                   value="@startlist.DistanceKm.ToString(CultureInfo.InvariantCulture)" @onchange="@(async (ChangeEventArgs args) => { await startlist.InputDistance(args, toasts); await SaveRace(); })">
                            <span class="form-control">Km</span>
                        </div>
                    </div>
                    <div class="d-flex">
                        <button class="btn btn-normal" @onclick="() => currentRace.Startlists.Remove(startlist)">
                            <span>Delete</span>
                            <i class="bi btn-bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        }


        <div class="box-body">
            <div class="top-row">
                <div class="top-row-buttons">
                    <button class="btn btn-normal" @onclick="@(AddStartlist)">
                        <span>Add</span>
                        <i class="bi btn-bi bi-plus-lg"></i>
                    </button>
                    <a class="btn btn-normal" href="/races/edit/@currentRace.Id">
                        <span>Edit</span>
                        <i class="bi btn-bi bi-pen"></i>
                    </a>
                </div>
            </div>

        </div>
    </div>

}
else
{
    <div class="page-spinner spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}


@code {
    private Race? currentRace;
    private Toasts toasts = new Toasts();

    protected override async Task OnInitializedAsync()
    {
        currentRace = await CreateNewRace();
    }

    private async Task<Race> CreateNewRace()
    {
        var races = await RaceService.GetRacesAsync(jsRuntime);

        Race addRace = new Race()
        {
            Name = "Untitled Race",
            Startlists = new List<Startlist>(),
            creationDateTime = DateTime.Now,
            lastEditDateTime = DateTime.Now,
            Id = IdGenerator.GenerateUniqueId(races.Select(race => race.Id))
        };

        races.Add(addRace);
        await RaceService.SaveRacesAsync(races, jsRuntime);

        return addRace;
    }

    private async Task UpdateName(ChangeEventArgs e)
    {
        if (e.Value == null || currentRace == null)
        {
            return;
        }
        currentRace.Name = e.Value?.ToString() ?? string.Empty;
        await SaveRace();
    }

    private async Task SaveRace()
    {
        currentRace.lastEditDateTime = DateTime.Now;
        await RaceService.UpdateRaceAsync(currentRace, JS);
    }

    private async Task AddStartlist()
    {
        Startlist addStartlist = new Startlist("Untitled Startlist", currentRace.Startlists.Select(s => s.Id));

        currentRace.Startlists.Add(addStartlist);
        await SaveRace();

    }
}